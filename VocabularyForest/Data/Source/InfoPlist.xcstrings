    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نستخدم بياناتك لتقديم إعلانات أفضل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden deine Daten, um dir bessere Werbung zu zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We use your data to deliver better ads."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos tus datos para ofrecerte anuncios más relevantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous utilisons tes données pour te proposer de meilleures publicités."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपको बेहतर विज्ञापन दिखाने के लिए आपके डेटा का उपयोग करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiamo i tuoi dati per mostrarti pubblicità migliori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より適した広告を表示するために、あなたのデータを利用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 알맞은 광고를 제공하기 위해 데이터를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos seus dados para oferecer anúncios melhores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы используем ваши данные для показа более релевантной рекламы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verilerinizi, size daha iyi reklamlar sunmak için kullanıyoruz."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们使用你的数据来提供更合适的广告。"
          }
        }
      }
    }
  },
  "version" : "1.1"
