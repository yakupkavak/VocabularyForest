    "Hesabınız ve buluta kaydedilen tüm verileriniz kalıcı olarak silinir. Cihazınızdaki veriler etkilenmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and all data saved to the cloud will be permanently deleted. Data on your device will not be affected."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y todos los datos guardados en la nube se eliminarán de forma permanente. Los datos de tu dispositivo no se verán afectados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta e todos os dados salvos na nuvem serão excluídos permanentemente. Os dados no seu dispositivo não serão afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш аккаунт и все данные, сохранённые в облаке, будут удалены навсегда. Данные на вашем устройстве не будут затронуты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız ve buluta kaydedilen tüm verileriniz kalıcı olarak silinir. Cihazınızdaki veriler etkilenmez."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف حسابك وجميع بياناتك المحفوظة في السحابة نهائيًا. لن تتأثر البيانات الموجودة على جهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle in der Cloud gespeicherten Daten werden dauerhaft gelöscht. Die Daten auf deinem Gerät bleiben unberührt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte et toutes les données enregistrées dans le cloud seront définitivement supprimés. Les données de ton appareil ne seront pas affectées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account e tutti i dati salvati nel cloud verranno eliminati definitivamente. I dati sul tuo dispositivo non verranno toccati."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账户以及保存在云端的所有数据都将被永久删除。设备上的数据不会受到影响。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとクラウドに保存されたすべてのデータが完全に削除されます。端末内のデータは影響を受けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정과 클라우드에 저장된 모든 데이터가 영구적으로 삭제됩니다. 기기에 있는 데이터는 영향을 받지 않아요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका खाता और क्लाउड में सहेजा गया सारा डेटा हमेशा के लिए हटा दिया जाएगा। आपके डिवाइस का डेटा प्रभावित नहीं होगा।"
          }
        }
      }
    },
    "Hesap silinemedi. Lütfen tekrar deneyin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account could not be deleted. Please try again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo eliminar la cuenta. Inténtalo de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível excluir a conta. Tente novamente."
