    "%@ kitaplığı ve içindeki tüm kelimeler kalıcı olarak silinecek. Bu işlem geri alınamaz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ and every word inside it will be deleted permanently. This action cannot be undone."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y todas las palabras que contiene se eliminarán permanentemente. Esta acción no se puede deshacer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e todas as palavras dentro dela serão excluídas permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и все слова внутри будут удалены безвозвратно. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kitaplığı ve içindeki tüm kelimeler kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف %@ وجميع الكلمات بداخلها نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und alle darin enthaltenen Wörter werden dauerhaft gelöscht. Diese Aktion kann nicht widerrufen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et tous les mots qu'elle contient seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e tutte le parole al suo interno verranno eliminate definitivamente. L'operazione non può essere annullata."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 及其中的所有单词将被永久删除。此操作无法撤销。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ とその中のすべての単語が完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 및 그 안의 모든 단어가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ और उसमें मौजूद सभी शब्द हमेशा के लिए हटा दिए जाएंगे। इस क्रिया को पूर्ववत नहीं किया जा सकता।"
          }
        }
      }
    },
