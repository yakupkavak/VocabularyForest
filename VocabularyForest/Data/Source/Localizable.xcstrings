    "Kendi zihnine hoş geldin. Bizler öğrendiğin kelimelerin yansımalarıyız" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أهلًا بك في عقلك. نحن انعكاسات الكلمات التي تعلّمتها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen in deinem eigenen Geist. Wir sind die Spiegelungen der Wörter, die du gelernt hast"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to your own mind. We are reflections of the words you have learned"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido a tu propia mente. Somos los reflejos de las palabras que has aprendido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans ton propre esprit. Nous sommes les reflets des mots que tu as appris"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने ही मन में आपका स्वागत है। हम उन शब्दों के प्रतिबिंब हैं जो आपने सीखे हैं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuto nella tua mente. Siamo i riflessi delle parole che hai imparato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の心へようこそ。私たちはあなたが学んだ言葉の反映です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너 자신의 마음에 온 걸 환영해. 우리는 네가 배운 단어들의 반영이야"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo à sua própria mente. Somos os reflexos das palavras que você aprendeu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добро пожаловать в твой разум. Мы — отражения слов, которые ты выучил"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi zihnine hoş geldin. Bizler öğrendiğin kelimelerin yansımalarıyız"
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎来到你自己的心灵。我们是你学过的词语的倒影"
          }
        }
      }
    },
