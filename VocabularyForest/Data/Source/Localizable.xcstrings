    "Düşmanı %lld doğru seçimle yenebilirsin. %lld canın var." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can defeat the enemy with %lld right choices. You have %lld health."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes derrotar al enemigo con %lld respuestas correctas. Tienes %lld de salud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode derrotar o inimigo com %lld escolhas certas. Você tem %lld de vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы можете победить врага, сделав %lld верных выборов. У вас %lld здоровья."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Düşmanı %1$lld doğru seçimle yenebilirsin. %2$lld canın var."
          }
        }
      }
    },
    "Düşmanları %lld, Patronu ise %lld doğru seçimle yenebilirsin. %lld canın var." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can defeat enemies with %lld, and the Boss with %lld correct choices. You have %lld health."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes derrotar a enemigos con %lld de salud y a jefes con %lld de salud tomando las decisiones correctas. Tienes %lld de salud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode derrotar inimigos com %lld, e o Chefe com %lld escolhas certas. Você tem %lld de vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете победить врагов, сделав %lld, а Босса — %lld правильных выборов. У вас %lld здоровья."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Düşmanların %1$lld, Patronun ise %2$lld doğru seçimle yenebilirsin. %3$lld canın var."
