    "Birlikte öğrenerek ormanımızı baştan yetiştirebiliriz" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By learning together, we can rebuild our forest from scratch."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendiendo juntos, podemos reconstruir nuestro bosque desde cero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aprendermos juntos, podemos reconstruir nossa floresta do zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учась вместе, мы сможем восстановить наш лес с нуля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte öğrenerek ormanımızı baştan yetiştirebiliriz"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالتعلّم معًا يمكننا إعادة إنماء غابتنا من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn wir zusammen lernen, können wir unseren Wald von neuem aufwachsen lassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En apprenant ensemble, nous pouvons faire repousser notre forêt depuis le début."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imparando insieme possiamo far ricrescere la nostra foresta da zero."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起学习，我们就能让森林重新长起来。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に学べば、森をもう一度育てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 배우면 우리 숲을 처음부터 다시 키울 수 있어요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ मिलकर सीखते हुए हम अपने जंगल को शुरू से फिर उगा सकते हैं।"
          }
        }
      }
    },
