    "Sadece kısa süreli hafızandaki kelimelerle; açıklama veya örnek desteğiyle oyna." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play only with words from your short-term memory; use explanations or examples to help you."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juega solo con palabras de tu memoria a corto plazo; usa explicaciones o ejemplos para ayudarte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brinque apenas com palavras da sua memória de curto prazo; use explicações ou exemplos para ajudá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Играйте только со словами из вашей кратковременной памяти; используйте объяснения или примеры, чтобы помочь себе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece kısa süreli hafızandaki kelimelerle; açıklama veya örnek desteğiyle oyna."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العب فقط بالكلمات الموجودة في ذاكرتك قصيرة المدى؛ بمساعدة الشروح أو الأمثلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele nur mit Wörtern aus deinem Kurzzeitgedächtnis – mit Beschreibung oder Beispiel als Hilfe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue uniquement avec les mots de ta mémoire courte, avec l'aide des descriptions ou des exemples."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gioca solo con le parole della tua memoria breve, con l'aiuto di descrizioni o esempi."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只用短期记忆中的单词来玩，可以借助说明或示例。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短期記憶の単語だけで、説明や例文のヒント付きでプレイします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단기 기억에 있는 단어만으로, 설명이나 예문의 도움을 받아 플레이해요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ अपनी अल्पकालिक स्मृति के शब्दों से खेलें; विवरण या उदाहरण की मदद के साथ।"
          }
        }
      }
    },
    "Sadece uzun süreli hafızandaki (öğrenilmiş) kelimelerle oyna." : {
