    "Bitkilerin sağlıksız bir toprakta kuruyacaktır, hayvanların ise hareket edemeyecekler.." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plants will dry up in unhealthy soil, and animals will be unable to move."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plantas se secarán en un suelo poco saludable y los animales no podrán moverse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As plantas secarão em solo insalubre e os animais não conseguirão se mover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растения засыхают в нездоровой почве, а животные не могут передвигаться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitkilerin sağlıksız bir toprakta kuruyacaktır, hayvanların ise hareket edemeyecekler.."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستجف النباتات في التربة غير الصحية، ولن تتمكن الحيوانات من الحركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einem unfruchtbaren Boden trocknen die Pflanzen aus und die Tiere können sich nicht mehr bewegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un sol malsain, les plantes se dessèchent et les animaux ne peuvent plus bouger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un terreno malsano le piante si seccano e gli animali non riescono più a muoversi."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土壤不健康时，植物会枯萎，动物也无法走动。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土が健康でないと植物は枯れ、動物は動けなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강하지 않은 토양에서는 식물이 마르고 동물은 움직일 수 없게 돼요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्वस्थ मिट्टी में पौधे सूख जाएंगे और जानवर हिल भी नहीं पाएंगे।"
          }
        }
      }
    },
