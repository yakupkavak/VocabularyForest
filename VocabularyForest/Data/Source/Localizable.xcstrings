    "Kısa süreli hafızandaki kelimeleri gör; doğru bildikçe onları uzun süreli hafızana taşı!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See the words in your short-term memory; as you get them right, transfer them to your long-term memory!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa las palabras en tu memoria a corto plazo; a medida que las aprendas correctamente, ¡transfiérelas a tu memoria a largo plazo!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja as palavras na sua memória de curto prazo; à medida que as acertar, transfira-as para a sua memória de longo prazo!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите слова в своей краткосрочной памяти; когда вы их запомните, перенесите их в долговременную память!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa süreli hafızandaki kelimeleri gör; doğru bildikçe onları uzun süreli hafızana taşı!"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطّلع على الكلمات في ذاكرتك قصيرة المدى؛ وكلما أجبت عنها بشكل صحيح، انقلها إلى ذاكرتك طويلة المدى!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir die Wörter in deinem Kurzzeitgedächtnis an und schiebe sie mit jeder richtigen Antwort in dein Langzeitgedächtnis!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde les mots de ta mémoire courte et fais-les passer dans ta mémoire longue à chaque bonne réponse !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda le parole nella tua memoria breve e portale nella memoria lunga a ogni risposta corretta!"
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看短期记忆中的单词，答对后把它们移入长期记忆！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短期記憶の単語を確認して、正解するたびに長期記憶へ移そう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단기 기억에 있는 단어를 확인하고, 맞힐 때마다 장기 기억으로 옮겨 보세요!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी अल्पकालिक स्मृति के शब्द देखें; सही बताते जाइए और उन्हें दीर्घकालिक स्मृति में ले जाइए!"
          }
        }
      }
    },
