    "Görevleri tamamlayarak yağmur taneleri toplayıp, hazneni doldurduğunda ekranında belirecek butona tıklayarak yağmur yağdırabilirsin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By completing the quests and collecting raindrops, you can make it rain by clicking the button that appears on your screen when your reservoir is full.\n"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al completar las misiones y recolectar gotas de lluvia, puedes hacer que llueva haciendo clic en el botón que aparece en tu pantalla cuando tu depósito esté lleno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao completar as missões e coletar gotas de chuva, você pode fazer chover clicando no botão que aparece na tela quando o reservatório estiver cheio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняя квесты и собирая капли дождя, вы можете вызвать дождь, нажав на кнопку, которая появляется на экране, когда ваш резервуар заполнен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görevleri tamamlayarak yağmur taneleri toplayıp, hazneni doldurduğunda ekranında belirecek butona tıklayarak yağmur yağdırabilirsin."
          }
        }
      }
    },
