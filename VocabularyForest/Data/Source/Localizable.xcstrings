    "Buluttaki orman bu cihazdakinden farklı. Lütfen hangi ormanı kullanmak istediğinizi seçin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الغابة الموجودة في السحابة مختلفة عن تلك الموجودة على هذا الجهاز. يرجى اختيار الغابة التي تريد استخدامها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wald in der Cloud unterscheidet sich von dem auf diesem Gerät. Bitte wähle aus, welchen Wald du verwenden möchtest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forêt dans le cloud est différente de celle sur cet appareil. Choisis la forêt que tu veux utiliser."
