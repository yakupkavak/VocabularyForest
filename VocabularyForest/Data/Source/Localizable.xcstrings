    "Oyuna başlayabilmek için en az %lld kelimeye ihtiyacın var." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need at least %lld words to start the game."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas al menos %lld palabras para comenzar el juego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de pelo menos %lld palavras para iniciar o jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для начала игры необходимо как минимум %lld слов."
          }
        },
        "tr" : {
