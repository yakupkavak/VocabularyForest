        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云端的森林与本设备上的不同。请选择你要使用的森林。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドの森とこの端末の森が異なります。どちらの森を使うか選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드의 숲이 이 기기의 숲과 달라요. 어떤 숲을 사용할지 선택해 주세요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लाउड का जंगल इस डिवाइस के जंगल से अलग है। कृपया चुनें कि आप कौन सा जंगल इस्तेमाल करना चाहते हैं।"
          }
        }
