    "Düşmanı %lld doğru seçimle yenebilirsin. %lld canın var." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك هزيمة العدو بـ %lld اختيارًا صحيحًا. لديك %lld نقطة حياة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Gegner besiegst du mit %1$lld richtigen Antworten. Du hast %2$lld Leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can defeat the enemy with %lld right choices. You have %lld health."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes derrotar al enemigo con %lld respuestas correctas. Tienes %lld de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux vaincre l'ennemi avec %1$lld bonnes réponses. Tu as %2$lld points de vie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप %1$lld सही जवाबों से दुश्मन को हरा सकते हैं। आपके पास %2$lld जान हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi sconfiggere il nemico con %1$lld risposte corrette. Hai %2$lld vite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敵は %1$lld 回正解すると倒せます。体力は %2$lld あります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적은 %1$lld번 정답을 맞히면 이길 수 있어요. 체력은 %2$lld이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode derrotar o inimigo com %lld escolhas certas. Você tem %lld de vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы можете победить врага, сделав %lld верных выборов. У вас %lld здоровья."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Düşmanı %1$lld doğru seçimle yenebilirsin. %2$lld canın var."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "答对 %1$lld 题可以击败敌人。你有 %2$lld 点生命。"
          }
        }
      }
    },
    "Düşmanları %lld, Patronu ise %lld doğru seçimle yenebilirsin. %lld canın var." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك هزيمة الأعداء بـ %lld اختيارًا صحيحًا، والزعيم بـ %lld اختيارًا صحيحًا. لديك %lld نقطة حياة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegner besiegst du mit %1$lld, den Boss mit %2$lld richtigen Antworten. Du hast %3$lld Leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can defeat enemies with %lld, and the Boss with %lld correct choices. You have %lld health."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes derrotar a enemigos con %lld de salud y a jefes con %lld de salud tomando las decisiones correctas. Tienes %lld de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux vaincre les ennemis avec %1$lld bonnes réponses et le boss avec %2$lld. Tu as %3$lld points de vie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप %1$lld सही जवाबों से दुश्मनों को और %2$lld सही जवाबों से बॉस को हरा सकते हैं। आपके पास %3$lld जान हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi sconfiggere i nemici con %1$lld risposte corrette e il boss con %2$lld. Hai %3$lld vite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敵は %1$lld 回、ボスは %2$lld 回正解すると倒せます。体力は %3$lld あります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적은 %1$lld번, 보스는 %2$lld번 정답을 맞히면 이길 수 있어요. 체력은 %3$lld이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode derrotar inimigos com %lld, e o Chefe com %lld escolhas certas. Você tem %lld de vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете победить врагов, сделав %lld, а Босса — %lld правильных выборов. У вас %lld здоровья."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Düşmanların %1$lld, Patronun ise %2$lld doğru seçimle yenebilirsin. %3$lld canın var."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "答对 %1$lld 题可以击败敌人，答对 %2$lld 题可以击败首领。你有 %3$lld 点生命。"
          }
        }
      }
