          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa foresta è collegata a un altro account. Accedi con il tuo account oppure reimposta il gioco."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
