    "A secret is hidden in the depths of the forest. Pass this tough test, reach the noble white cat." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A secret is hidden in the depths of the forest. Pass this tough test, reach the noble white cat."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un secreto escondido en lo profundo del bosque. Supera esta difícil prueba y llega hasta el noble gato blanco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um segredo está escondido nas profundezas da floresta. Passe neste difícil teste e alcance o nobre gato branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В глубине леса скрывается секрет. Пройди это сложное испытание, доберись до благородного белого кота."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ormanın derinliklerinde bir sır saklı. Bu zorlu sınavı geç, asil beyaz kediye ulaş."
          }
        }
      }
    },
