    "Hangi özellikleri kullandığını anonim olarak ölçer ve uygulamayı geliştirmemize yardım eder. Kapatırsan hiçbir kullanım verisi gönderilmez." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس الميزات التي تستخدمها بشكل مجهول ويساعدنا على تحسين التطبيق. عند إيقافه لا تُرسل أي بيانات استخدام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst anonym, welche Funktionen du nutzt, und hilft uns, die App zu verbessern. Wenn du das ausschaltest, werden keine Nutzungsdaten gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures which features you use, anonymously, and helps us improve the app. Turn it off and no usage data is sent."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide de forma anónima qué funciones usas y nos ayuda a mejorar la app. Si lo desactivas, no se envía ningún dato de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure de façon anonyme les fonctionnalités que tu utilises et nous aide à améliorer l'app. Si tu le désactives, aucune donnée d'utilisation n'est envoyée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गुमनाम रूप से मापता है कि आप कौन-सी सुविधाएँ इस्तेमाल करते हैं और ऐप को बेहतर बनाने में मदद करता है। बंद करने पर कोई उपयोग डेटा नहीं भेजा जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura in forma anonima quali funzioni usi e ci aiuta a migliorare l'app. Se lo disattivi, non viene inviato alcun dato di utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの機能を使っているかを匿名で計測し、アプリの改善に役立てます。オフにすると利用データは一切送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 기능을 사용하는지 익명으로 측정해 앱을 개선하는 데 사용합니다. 끄면 사용 데이터가 전혀 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede de forma anônima quais recursos você usa e nos ajuda a melhorar o app. Se desativar, nenhum dado de uso é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонимно измеряет, какими функциями вы пользуетесь, и помогает нам улучшать приложение. Если выключить, данные об использовании не отправляются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangi özellikleri kullandığını anonim olarak ölçer ve uygulamayı geliştirmemize yardım eder. Kapatırsan hiçbir kullanım verisi gönderilmez."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名统计你使用了哪些功能，帮助我们改进应用。关闭后不会发送任何使用数据。"
          }
        }
      }
    },
    "happiness" : {
      "extractionState" : "stale",
