          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto konnte nicht gelöscht werden. Bitte versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
