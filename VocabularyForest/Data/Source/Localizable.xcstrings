          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह जंगल किसी दूसरे खाते से जुड़ा है। कृपया अपने खाते से साइन इन करें या गेम रीसेट करें।"
          }
        }
      }
    },
