    "İnternet bağlantınız yok. Ödüllerinizi almak için lütfen bağlantınızı kontrol edip tekrar deneyin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have no internet connection. Please check your connection and try again to claim your rewards."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión a internet. Comprueba tu conexión e inténtalo de nuevo para reclamar tus recompensas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está sem conexão com a internet. Verifique sua conexão e tente novamente para receber suas recompensas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к интернету. Проверьте соединение и повторите попытку, чтобы получить награды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet bağlantınız yok. Ödüllerinizi almak için lütfen bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد اتصال بالإنترنت. للحصول على مكافآتك، يرجى التحقق من اتصالك والمحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast keine Internetverbindung. Bitte überprüfe deine Verbindung und versuche es erneut, um deine Belohnungen abzuholen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n'as pas de connexion Internet. Vérifie ta connexion et réessaie pour récupérer tes récompenses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai una connessione a Internet. Controlla la connessione e riprova per riscuotere le tue ricompense."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你没有网络连接。请检查网络后重试，以领取你的奖励。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットに接続されていません。接続を確認して、もう一度報酬の受け取りをお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷에 연결되어 있지 않아요. 연결을 확인하고 다시 시도해 보상을 받아 주세요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका इंटरनेट कनेक्शन नहीं है। कृपया कनेक्शन जांचें और इनाम लेने के लिए फिर कोशिश करें।"
          }
        }
      }
    },
