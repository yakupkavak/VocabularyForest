    "Ormanına can vermek için doldurmalısın." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must fill it to give life to your forest."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debes llenarlo para dar vida a tu bosque."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você deve preenchê-lo para dar vida à sua floresta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы должны наполнить его, чтобы дать жизнь вашему лесу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ormanına can vermek için doldurmalısın."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تملأه لتمنح الحياة لغابتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst sie füllen, um deinem Wald Leben zu geben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dois le remplir pour donner vie à ta forêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devi riempirlo per dare vita alla tua foresta."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你必须把它填满，才能让森林充满生机。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "森に命を与えるには、これを満たす必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숲에 생명을 주려면 가득 채워야 해요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने जंगल में जान डालने के लिए आपको इसे भरना होगा।"
          }
        }
      }
    },
    "Ormanına hoşgeldin! Görevleri tamamlayarak ormanına hayat katabilirsin. Toprağın zamanla kuruyacaktır, bunun için yağmur yağdırmayı unutma!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to your forest! You can bring your forest to life by completing tasks. The soil will dry out over time, so don't forget to make it rain!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Bienvenido a tu bosque! Puedes darle vida a tu bosque completando tareas. El suelo se secará con el tiempo, ¡así que no olvides hacer llover!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo à sua floresta! Você pode dar vida à sua floresta completando tarefas. O solo vai secar com o tempo, então não se esqueça de fazer chover!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добро пожаловать в ваш лес! Вы можете оживить свой лес, выполняя задания. Со временем почва высохнет, поэтому не забудьте вызвать дождь!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ormanına hoşgeldin! Görevleri tamamlayarak ormanına hayat katabilirsin. Toprağın zamanla kuruyacaktır, bunun için yağmur yağdırmayı unutma!"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا بك في غابتك! يمكنك بث الحياة في غابتك بإكمال المهام. ستجف التربة بمرور الوقت، فلا تنسَ إنزال المطر!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen in deinem Wald! Indem du Aufgaben abschließt, kannst du deinen Wald zum Leben bringen. Der Boden trocknet mit der Zeit aus – vergiss also nicht, Regen zu machen!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans ta forêt ! En accomplissant les tâches, tu peux donner vie à ta forêt. Le sol s'assèchera avec le temps, alors n'oublie pas de faire tomber la pluie !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuto nella tua foresta! Completando le attività puoi dare vita alla tua foresta. Con il tempo il terreno si secca, quindi non dimenticare di far piovere!"
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎来到你的森林！完成任务就能让森林充满生机。土壤会随着时间变干，别忘了下雨！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの森へようこそ！タスクをこなすと森に命が宿ります。土は時間とともに乾くので、雨を降らせるのを忘れないで！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 숲에 온 것을 환영해요! 과제를 완료하면 숲에 생기를 불어넣을 수 있어요. 토양은 시간이 지나면 마르니 비를 내리는 걸 잊지 마세요!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने जंगल में आपका स्वागत है! काम पूरे करके आप अपने जंगल में जान डाल सकते हैं। समय के साथ मिट्टी सूख जाएगी, इसलिए बारिश कराना न भूलें!"
          }
        }
      }
    },
    "Ormanını buluta kaydetmek için giriş yap." : {
      "localizations" : {
