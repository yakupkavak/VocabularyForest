    "Kısa süreli hafızandaki kelimeleri gör; doğru bildikçe onları uzun süreli hafızana taşı!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See the words in your short-term memory; as you get them right, transfer them to your long-term memory!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa las palabras en tu memoria a corto plazo; a medida que las aprendas correctamente, ¡transfiérelas a tu memoria a largo plazo!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja as palavras na sua memória de curto prazo; à medida que as acertar, transfira-as para a sua memória de longo prazo!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите слова в своей краткосрочной памяти; когда вы их запомните, перенесите их в долговременную память!"
          }
        },
        "tr" : {
          "stringUnit" : {
