    "Sadece kısa süreli hafızandaki kelimelerle; açıklama veya örnek desteğiyle oyna." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play only with words from your short-term memory; use explanations or examples to help you."
