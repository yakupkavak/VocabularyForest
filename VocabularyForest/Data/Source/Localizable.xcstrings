    "Bu orman başka bir hesaba bağlı. Lütfen kendi hesabınıza giriş yapın veya oyunu sıfırlayın." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This forest is linked to another account. Please sign in to your own account or reset the game."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este bosque está vinculado a otra cuenta. Inicia sesión con tu propia cuenta o reinicia el juego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta floresta está vinculada a outra conta. Faça login na sua própria conta ou reinicie o jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот лес привязан к другому аккаунту. Войдите в свой аккаунт или сбросьте игру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu orman başka bir hesaba bağlı. Lütfen kendi hesabınıza giriş yapın veya oyunu sıfırlayın."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الغابة مرتبطة بحساب آخر. يرجى تسجيل الدخول إلى حسابك الخاص أو إعادة تعيين اللعبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
